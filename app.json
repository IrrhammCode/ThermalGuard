{
  "expo": {
    "name": "ATA²",
    "slug": "ata2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ata2",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ata2.coolcorridor",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ATA² uses your location to pin the Hold tab if you are in downtown Phoenix. Otherwise it stays on the Civic Space Park demo pin."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07090C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#07090C"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ATA² uses your location to pin the Hold tab if you are in downtown Phoenix. Otherwise it stays on the Civic Space Park demo pin."
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
